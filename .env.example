APP_NAME="Vowt Scheduler"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8095

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Banco de dados -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=schedule_service
DB_USERNAME=schedule_service
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Portas expostas no host (docker-compose)
APP_PORT=8095
OCTANE_PORT=8096
# Endereco do host onde a porta do banco e publicada. 127.0.0.1 = so a
# propria maquina. No servidor compartilhado use o IP da WireGuard
# (10.66.66.1) para alcancar de fora pela VPN, nunca 0.0.0.0.
DB_BIND_ADDRESS=127.0.0.1
DB_PORT_EXTERNAL=3310
# Mesma ideia da DB_BIND_ADDRESS, para o Redis.
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT_EXTERNAL=6382

# --- Sessão / cache / filas ----------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Octane ---------------------------------------------------------------
OCTANE_SERVER=swoole
OCTANE_HTTPS=false
OCTANE_WORKERS=4
OCTANE_TASK_WORKERS=16
OCTANE_MAX_REQUESTS=500

# --- Agendador ------------------------------------------------------------
SCHEDULER_PARALLEL_DRIVER=octane
SCHEDULER_OCTANE_HOST=octane
SCHEDULER_OCTANE_PORT=8000
SCHEDULER_PARALLEL_CHUNK=10
SCHEDULER_PARALLEL_QUEUE=parallel
SCHEDULER_SEQUENTIAL_QUEUE=sequential
SCHEDULER_DEFAULT_GROUP=default
SCHEDULER_LOCK_SECONDS=3600
SCHEDULER_DEFAULT_TIMEOUT=60
SCHEDULER_DEFAULT_MAX_ATTEMPTS=1
SCHEDULER_DEFAULT_TIMEZONE=America/Sao_Paulo
SCHEDULER_MAX_TIMEOUT=900
SCHEDULER_RUN_RETENTION_DAYS=30
SCHEDULER_COMMAND_ALLOWLIST_ENABLED=true
SCHEDULER_COMMAND_ALLOWLIST=php,curl,echo,ls,artisan
SCHEDULER_HTTP_ALLOW_INSECURE=false

# --- Painel / OTP ---------------------------------------------------------
PANEL_ALLOWED_EMAILS=suporte@vowt.com.br
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
PANEL_SESSION_LIFETIME=480

# --- E-mail (envio do OTP) ------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=vowt.virtuaserver.com.br
MAIL_PORT=587
MAIL_USERNAME=notificacoesvowt@webthomaz.com
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notificacoesvowt@webthomaz.com"
MAIL_FROM_NAME="${APP_NAME}"

# Requisições por minuto por cliente de API
SCHEDULER_API_RATE_LIMIT=120
